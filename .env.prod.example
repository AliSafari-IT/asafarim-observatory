# Copy to .env.prod and enter the API key locally. Never commit .env.prod.
OPENAI_API_KEY=
OBSERVATORY_OPENAI_MODEL=gpt-5-mini

# Authenticated hosting: set these before encrypting the server configuration.
# OBSERVATORY_AUTH_ENABLED=true
# OBSERVATORY_ORIGIN=https://observatory.example.com
# OBSERVATORY_ISSUER=https://id.asafarim.site
# OBSERVATORY_CLIENT_ID=observatory
# OBSERVATORY_REDIS_URL=redis://observatory-redis:6379/0
# OBSERVATORY_SESSION_SECRET=
# OBSERVATORY_SMTP_HOST=
# OBSERVATORY_SMTP_PORT=465
# OBSERVATORY_SMTP_SECURITY=tls
# OBSERVATORY_SMTP_USER=
# OBSERVATORY_SMTP_PASSWORD=
# OBSERVATORY_SMTP_FROM=
# OBSERVATORY_VPS_WORKSPACE=false
